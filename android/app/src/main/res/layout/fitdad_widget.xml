<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg">

    <LinearLayout android:id="@+id/w_stats_area" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">

    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="Upkeep" android:textColor="#F59E0B" android:textStyle="bold" android:textSize="14sp" />
            <TextView android:id="@+id/w_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Not started" android:textColor="#8B95A5" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp" android:gravity="bottom">
            <LinearLayout android:id="@+id/w_water_block" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/w_water" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.00 / 3.00 L" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="20sp" />
                <TextView android:id="@+id/w_water_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Glass 1 of 12" android:textColor="#8B95A5" android:textSize="11sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_stand_block" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/w_stands" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="#34D399" android:textStyle="bold" android:textSize="20sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="stand-ups" android:textColor="#8B95A5" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="6dp"
            android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_progress" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="4dp">
            <Chronometer android:id="@+id/w_ago_stand" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#34D399" android:textSize="11sp" android:visibility="gone" />
            <Chronometer android:id="@+id/w_ago_water" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textColor="#38BDF8" android:textSize="11sp" android:visibility="gone" />
            <TextView android:id="@+id/w_ago_none" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="No taps yet today" android:textColor="#8B95A5" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:id="@+id/w_week" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="" android:textColor="#8B95A5" android:textSize="11sp" android:maxLines="1" />
    </LinearLayout>

    <!-- Countdown to the next reminder: big numbers on the right, water blue / stand-up green -->
    <LinearLayout android:id="@+id/w_next_col" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="end|center_vertical" android:layout_marginStart="10dp" android:minWidth="84dp">
        <LinearLayout android:id="@+id/w_next_water_block" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_next_water_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="💧 next glass" android:textColor="#8B95A5" android:textSize="10sp" android:maxLines="1" />
            <Chronometer android:id="@+id/w_next_water" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#38BDF8" android:textStyle="bold" android:textSize="24sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_next_water_txt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#38BDF8" android:textStyle="bold" android:textSize="15sp" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_next_stand_block" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="end" android:layout_marginTop="6dp">
            <TextView android:id="@+id/w_next_stand_at" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🧍 next stand-up" android:textColor="#8B95A5" android:textSize="10sp" android:maxLines="1" />
            <Chronometer android:id="@+id/w_next_stand" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#34D399" android:textStyle="bold" android:textSize="24sp" android:includeFontPadding="false" />
            <TextView android:id="@+id/w_next_stand_txt" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#34D399" android:textStyle="bold" android:textSize="15sp" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_btn_water" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="38dp"
            android:background="@drawable/widget_btn_water" android:gravity="center" android:text="+ 250 ml"
            android:textColor="#0E1116" android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/w_btn_stand" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="38dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_btn_stand" android:gravity="center"
            android:text="Stood up ✓" android:textColor="#0E1116" android:textStyle="bold" android:textSize="13sp" />
        <TextView android:id="@+id/w_btn_main" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="38dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_btn_main" android:gravity="center"
            android:text="Start" android:textColor="#0E1116" android:textStyle="bold" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
